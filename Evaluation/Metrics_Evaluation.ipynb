      ],
      "source": [
        "# COMET evaluation\n",
        "comet_scores = comet.score(\n",
        "    src=loader.source,\n",
        "    mt=loader.hyp_target,   # SYSTEM OUTPUT\n",
        "    ref=loader.target       # GOLD REFERENCE\n",
        ")\n",
        "\n",
        "# BLEU evaluation\n",
        "bleu_scores = bleu.score(\n",
        "    hyp=loader.hyp_target,\n",
        "    ref=loader.target\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "9QrYKm41GEld"
      },
      "source": [
        "# Save Results"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "metadata": {
        "id": "tbDUU1w-CaYO"
      },
      "outputs": [],
      "source": [
        "def save_scores_only_tsv(save_path, bleu_scores, comet_scores):\n",
        "    with open(save_path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n",
        "        writer = csv.writer(f, delimiter=\"\\t\")\n",
        "\n",
        "        # Header\n",
        "        writer.writerow([\"id\", \"bleu\", \"comet\"])\n",
        "\n",
        "        # Rows\n",
        "        for i, (bleu, comet) in enumerate(zip(bleu_scores, comet_scores)):\n",
        "            writer.writerow([i, bleu, comet])"
      ]
    },
